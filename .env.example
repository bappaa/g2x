# =====================================================================
#  G2X.GG — environment configuration
#  Copy to `.env.local` (development) or set these as real environment
#  variables on your server (production).
#
#  Verify everything with:  npm run check:env
# =====================================================================

# ─────────────── Sessions (REQUIRED) ───────────────
# The only value you MUST set. Sign-in breaks without it.
# Generate one with:  openssl rand -base64 48
#   (no openssl? node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
# Use a DIFFERENT secret in production than in development.
# Changing it logs every user out.
AUTH_SECRET=replace-with-a-long-random-string


# ─────────────── Database ───────────────
# LEAVE BOTH COMMENTED OUT FOR LOCAL DEVELOPMENT.
# When TURSO_DATABASE_URL is unset the app uses a local SQLite file
# (./g2x.db) and needs no cloud account at all.
#
# For PRODUCTION create a Turso database:
#   curl -sSfL https://get.tur.so/install.sh | bash
#   turso auth login
#   turso db create g2x
#   turso db show g2x --url        ->  TURSO_DATABASE_URL
#   turso db tokens create g2x     ->  TURSO_AUTH_TOKEN
#
# TURSO_DATABASE_URL=libsql://g2x-yourorg.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...


# ─────────────── App URL (REQUIRED in production) ───────────────
# Your public origin, no trailing slash. Used for the Google OAuth
# redirect URI, links inside emails, and the POST origin allowlist
# in middleware.ts — a wrong value here causes 403s on every form.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ─────────────── Google OAuth (optional) ───────────────
# console.cloud.google.com -> Credentials -> OAuth client (Web)
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google?callback=1
# Leave blank and the Google button signs in a demo account instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─────────────── Transactional email — Resend (optional) ───────────────
# resend.com -> API Keys -> Create API key
# Leave blank and emails are printed to the server console instead of sent.
# Test it from Admin -> Settings -> Transactional email -> "Send test email".
RESEND_API_KEY=

# Verified sending domain in Resend. Until g2x.gg is verified you can point
# this at any domain you HAVE verified (or leave blank to use the addresses
# as-is). Department addresses keep their names, only the domain is swapped:
#   support@g2x.gg -> support@<MAIL_DOMAIN>
MAIL_DOMAIN=


# ─────────────── KYC document storage (optional) ───────────────
# Where uploaded ID documents are written. MUST be outside public/.
# Defaults to .private-uploads/ in the project root.
# On a VPS use an absolute path on a persistent disk, e.g. /var/lib/g2x/kyc
KYC_STORAGE_DIR=
